// ----------------------------------------------------------------------------
// 2. Monster Posture & Stun Tokens (Multi-Parry Stagger + Riposte/Deathblow)
// ----------------------------------------------------------------------------
class SekiroPostureToken : Inventory
{
    int postureHits;
    int decayTics;

    Default
    {
        Inventory.MaxAmount 1;
        +INVENTORY.UNDROPPABLE;
        +INVENTORY.UNTOSSABLE;
    }

    static int GetRequiredParries(Actor mon)
    {
        if (!mon) return 1;
        int maxHp = mon.SpawnHealth();
        if (maxHp <= 150) return 1;      // Imps, Zombies, Sergeants
        if (maxHp <= 450) return 2;      // Pinkies, Revenants, Cacos, Chaingunners
        return 3;                        // Hell Knights, Barons, Mancubi, Bosses
    }

    override void DoEffect()
    {
        Super.DoEffect();
        if (!owner || owner.health <= 0)
        {
            Destroy();
            return;
        }
        if (decayTics > 0)
        {
            decayTics--;
            if (decayTics == 0 && postureHits > 0)
            {
                postureHits--;
                if (postureHits > 0)
                    decayTics = 140;
            }
        }
    }
}

class SekiroStunToken : Inventory
{
    int stunTics;

    Default
    {
        Inventory.MaxAmount 1;
        +INVENTORY.UNDROPPABLE;
        +INVENTORY.UNTOSSABLE;
    }

    override void AttachToOwner(Actor other)
    {
        Super.AttachToOwner(other);
        int dur = CVar.GetCVar("sk_stun_tics").GetInt();
        stunTics = (dur > 0) ? dur : 105;
        if (owner)
        {
            owner.vel.x *= 0.15;
            owner.vel.y *= 0.15;
            State painSt = owner.FindState("Pain");
            if (painSt)
                owner.SetState(painSt);
        }
    }

    void RefreshStun(int tics)
    {
        stunTics = max(stunTics, tics);
        if (owner)
        {
            owner.vel.x *= 0.15;
            owner.vel.y *= 0.15;
            State painSt = owner.FindState("Pain");
            if (painSt)
                owner.SetState(painSt);
        }
    }

    override void DoEffect()
    {
        Super.DoEffect();
        if (!owner || owner.health <= 0)
        {
            Destroy();
            return;
        }

        if (stunTics > 0)
        {
            stunTics--;
            owner.vel.x *= 0.7;
            owner.vel.y *= 0.7;
            if (owner.tics < 3)
                owner.tics = 3;

            // Orbiting stagger sparks above head
            if ((stunTics % 5) == 0)
            {
                double ang = stunTics * 24.0;
                double rad = max(12.0, owner.radius * 0.65);
                Vector3 pos = owner.pos + (cos(ang) * rad, sin(ang) * rad, owner.height + 6.0);
                Actor.Spawn("SekiroStunIndicator", pos);
            }
        }
        else
        {
            State seeSt = owner.FindState("See");
            if (seeSt)
                owner.SetState(seeSt);
            Destroy();
        }
    }

    override void ModifyDamage(int damage, Name damageType, out int newdamage, bool passive, Actor inflictor, Actor source, int flags)
    {
        // Riposte / Deathblow bonus on melee hits against a stunned enemy!
        if (passive && damage > 0 && stunTics > 0 && damageType == 'SekiroSlash')
        {
            newdamage = damage * 3;
            if (owner)
            {
                owner.A_StartSound("AXECLN", CHAN_VOICE, CHANF_OVERLAP, 1.0, ATTN_NORM, 0.85);
                for (int i = 0; i < 6; i++)
                {
                    Vector3 sp = owner.pos + (frandom(-12, 12), frandom(-12, 12), owner.height * 0.6 + frandom(-8, 8));
                    Actor.Spawn("SekiroParrySpark", sp);
                }
                // Heal attacker if this riposte kills the stunned enemy
                if (source && source.player && owner.health - newdamage <= 0)
                {
                    let tok = SekiroParryToken(source.FindInventory("SekiroParryToken"));
                    if (tok)
                        tok.GrantDeathblowHeal();
                }
            }
            stunTics = 1;
        }
    }
}

// ----------------------------------------------------------------------------
// 3. Player Parry, Block, Deathblow & Skill State Token
// ----------------------------------------------------------------------------
class SekiroParryToken : Inventory
{
    int parryTics;        // Active timed-parry window
    int parryGraceTics;   // Post-parry grace window (multi-pellet bursts & execution i-frames)
    int guardTics;        // Held shield block (reduced chip damage, no stun)
    int parryFlashTics;   // HUD / sprite feedback timer
    int parryStreak;      // Consecutive successful parries
    int lastParryTic;     // Anti-spam tracker
    int parrySpamCount;   // Consecutive rapid whiffed RMB taps
    int dashTics;         // Active dash-slash timer
    int skillCD[10];      // Cooldown tics for skills 1..9
    int skillMaxCD[10];   // Max cooldown for HUD bar
    string lastBanner;
    int bannerTics;
    Actor execTarget;     // Stunned enemy locked for Deathblow execution

    Default
    {
        Inventory.MaxAmount 1;
        +INVENTORY.UNDROPPABLE;
        +INVENTORY.UNTOSSABLE;
    }

    override void DoEffect()
    {
        Super.DoEffect();
        if (parryTics > 0) parryTics--;
        if (parryGraceTics > 0) parryGraceTics--;
        if (guardTics > 0) guardTics--;
        if (parryFlashTics > 0) parryFlashTics--;
        if (bannerTics > 0) bannerTics--;

        for (int i = 1; i <= 9; i++)
        {
            if (skillCD[i] > 0)
                skillCD[i]--;
        }

        // Dash-slash automatic follow-up cleave
        if (dashTics > 0 && owner)
        {
            dashTics--;
            if (dashTics == 1)
            {
                owner.A_StartSound("AXSWING", CHAN_WEAPON, CHANF_OVERLAP, 1.0);
                for (int d = -1; d <= 1; d++)
                {
                    owner.LineAttack(owner.angle + d * 12.0, 115.0, owner.pitch, (d == 0) ? 70 : 40, 'SekiroSlash', "SekiroBladePuff", LAF_ISMELEEATTACK);
                }
            }
        }
    }

    bool IsInFront(Actor attacker) const
    {
        if (!owner || !attacker) return true;
        double angTo = owner.AngleTo(attacker);
        double diff = abs(Actor.DeltaAngle(owner.angle, angTo));
        return diff <= 85.0;
    }

    void GrantDeathblowHeal()
    {
        if (!owner || owner.health <= 0) return;
        int healAmt = CVar.GetCVar("sk_deathblow_heal").GetInt();
        if (healAmt <= 0) healAmt = 20;
        int maxHp = owner.GetMaxHealth(true);
        if (maxHp <= 0) maxHp = 100;
        int curHp = owner.player ? owner.player.health : owner.health;
        if (curHp < maxHp)
        {
            int gained = min(healAmt, maxHp - curHp);
            owner.GiveBody(gained, maxHp);
            lastBanner = String.Format("DEATHBLOW! +%d HP", gained);
        }
        else
        {
            lastBanner = "DEATHBLOW!";
        }
        bannerTics = 40;
        owner.A_SetBlend("44FF88", 0.22, 10);
    }

    void ApplyMeleePosture(Actor attacker)
    {
        if (!attacker || !attacker.bISMONSTER || attacker.health <= 0)
            return;

        int req = SekiroPostureToken.GetRequiredParries(attacker);
        int dur = CVar.GetCVar("sk_stun_tics").GetInt();
        if (dur <= 0) dur = 105;

        let post = SekiroPostureToken(attacker.FindInventory("SekiroPostureToken"));
        if (!post)
        {
            attacker.GiveInventory("SekiroPostureToken", 1);
            post = SekiroPostureToken(attacker.FindInventory("SekiroPostureToken"));
        }

        int curHits = 1;
        if (post)
        {
            post.postureHits++;
            post.decayTics = 175;
            curHits = post.postureHits;
        }

        if (curHits >= req)
        {
            if (post) post.postureHits = 0;
            let existing = SekiroStunToken(attacker.FindInventory("SekiroStunToken"));
            if (existing)
                existing.RefreshStun(dur);
            else
                attacker.GiveInventory("SekiroStunToken", 1);

            lastBanner = "STUNNED! [LMB / R] EXECUTE";
            bannerTics = 45;
        }
        else
        {
            lastBanner = String.Format("PARRY! POSTURE %d/%d", curHits, req);
            bannerTics = 30;
        }
    }

    void TriggerParrySuccess(Actor attacker, Actor proj, bool allowStun, string customBanner = "")
    {
        if (!owner) return;

        parryGraceTics = max(parryGraceTics, 6);
        parryFlashTics = 14;
        parrySpamCount = 0;
        parryStreak++;
        if (customBanner.Length() > 0)
            lastBanner = customBanner;
        else
            lastBanner = String.Format("PARRY! x%d", parryStreak);
        bannerTics = 35;

        owner.A_StartSound("AXECLN", CHAN_AUTO, CHANF_OVERLAP, 1.0, ATTN_NONE, frandom(0.95, 1.15));
        owner.A_SetBlend("FFD850", 0.24, 7);

        // Shave 15 tics off all skill cooldowns on every timed parry
        for (int i = 1; i <= 9; i++)
        {
            if (skillCD[i] > 15) skillCD[i] -= 15;
            else skillCD[i] = 0;
        }

        // Spawn parry sparks in front of shield
        Vector3 sparkPos = owner.pos + (cos(owner.angle) * 28.0, sin(owner.angle) * 28.0, owner.height * 0.65);
        for (int i = 0; i < 4; i++)
        {
            Actor.Spawn("SekiroParrySpark", sparkPos + (frandom(-8, 8), frandom(-8, 8), frandom(-6, 6)));
        }

        // Only melee parries build posture / stun enemies (blocked bullets do NOT stun)
        if (allowStun && attacker && attacker.bISMONSTER && attacker.health > 0)
        {
            ApplyMeleePosture(attacker);
        }
    }

    override void ModifyDamage(int damage, Name damageType, out int newdamage, bool passive, Actor inflictor, Actor source, int flags)
    {
        if (!passive || damage <= 0 || !owner)
            return;

        if (!source && !inflictor)
            return;
        if (source == owner)
            return;

        bool inParry = (parryTics > 0 || parryGraceTics > 0);
        Actor checkActor = inflictor ? inflictor : source;

        if (inParry && (parryGraceTics > 0 || IsInFront(checkActor)))
        {
            newdamage = 0;
            // Only stun if it's a melee attack (not a ranged hitscan/projectile)
            bool isMelee = (inflictor == source && owner.Distance3D(source) <= 135.0);
            TriggerParrySuccess(source, (inflictor && inflictor != source) ? inflictor : null, isMelee);
            return;
        }

        if (guardTics > 0 && IsInFront(checkActor))
        {
            // Shield Block (holding RMB after timed window): takes reduced chip damage, never stuns
            double mult = CVar.GetCVar("sk_block_dmg_mult").GetFloat();
            if (mult <= 0.05 || mult >= 1.0) mult = 0.35;
            newdamage = max(1, int(damage * mult));
            owner.A_StartSound("AXEWALL", CHAN_AUTO, CHANF_OVERLAP, 0.75, ATTN_NONE, 0.9);
            owner.A_SetBlend("88AAFF", 0.14, 5);
            return;
        }

        parryStreak = 0;
    }

    void CastSkill(int slot)
    {
        if (!owner || owner.health <= 0 || slot < 1 || slot > 9)
            return;

        if (skillCD[slot] > 0)
        {
            lastBanner = String.Format("Skill %d recharging...", slot);
            bannerTics = 18;
            return;
        }

        switch (slot)
        {
        case 1: // Axe Throw
            skillMaxCD[1] = 45;
            skillCD[1] = 45;
            owner.A_StartSound("weapons/axe/throw", CHAN_AUTO, CHANF_OVERLAP, 1.0);
            owner.A_SpawnProjectile("SekiroThrownAxe", 36, 0, 0, CMF_AIMDIRECTION, owner.pitch);
            lastBanner = "[1] AXE THROW";
            bannerTics = 28;
            break;

        case 2: // Quick Shot (3-round burst)
            skillMaxCD[2] = 35;
            skillCD[2] = 35;
            owner.A_StartSound("weapons/pistol", CHAN_AUTO, CHANF_OVERLAP, 1.0);
            for (int i = -1; i <= 1; i++)
            {
                owner.LineAttack(owner.angle + i * 1.5, 2048, owner.pitch, random(12, 18), 'Bullet', "BulletPuff");
            }
            lastBanner = "[2] QUICK BURST";
            bannerTics = 28;
            break;

        case 3: // Buckshot Blast
            skillMaxCD[3] = 75;
            skillCD[3] = 75;
            owner.A_StartSound("weapons/shotgf", CHAN_AUTO, CHANF_OVERLAP, 1.0);
            for (int i = 0; i < 8; i++)
            {
                owner.LineAttack(owner.angle + frandom(-5.5, 5.5), 1024, owner.pitch + frandom(-3.0, 3.0), random(8, 13), 'Shotgun', "BulletPuff");
            }
            owner.A_SetBlend("FFAA44", 0.12, 4);
            lastBanner = "[3] BUCKSHOT BLAST";
            bannerTics = 28;
            break;

        case 4: // Dash Slash (Sekiro lunge + cleave)
            skillMaxCD[4] = 80;
            skillCD[4] = 80;
            owner.vel.x += cos(owner.angle) * 24.0;
            owner.vel.y += sin(owner.angle) * 24.0;
            owner.vel.z += 2.5;
            dashTics = 7;
            owner.A_StartSound("AXEDRAW", CHAN_AUTO, CHANF_OVERLAP, 1.0);
            owner.A_SetBlend("FFFFFF", 0.12, 5);
            lastBanner = "[4] DASH SLASH";
            bannerTics = 28;
            break;

        case 5: // Minigun Barrage
            skillMaxCD[5] = 105;
            skillCD[5] = 105;
            owner.A_StartSound("weapons/chngun", CHAN_AUTO, CHANF_OVERLAP, 1.0);
            for (int i = 0; i < 10; i++)
            {
                owner.LineAttack(owner.angle + frandom(-4.0, 4.0), 2048, owner.pitch + frandom(-2.5, 2.5), random(8, 12), 'Bullet', "BulletPuff");
            }
            lastBanner = "[5] CHAINGUN VOLLEY";
            bannerTics = 28;
            break;

        case 6: // Rocket Strike
            skillMaxCD[6] = 140;
            skillCD[6] = 140;
            owner.A_StartSound("weapons/rocklf", CHAN_AUTO, CHANF_OVERLAP, 1.0);
            owner.A_SpawnProjectile("Rocket", 36, 0, 0, CMF_AIMDIRECTION, owner.pitch);
            lastBanner = "[6] ROCKET STRIKE";
            bannerTics = 28;
            break;

        case 7: // Plasma Fan (5 bolts)
            skillMaxCD[7] = 120;
            skillCD[7] = 120;
            owner.A_StartSound("weapons/plasmaf", CHAN_AUTO, CHANF_OVERLAP, 1.0);
            for (int i = -2; i <= 2; i++)
            {
                owner.A_SpawnProjectile("PlasmaBall", 36, 0, i * 5.0, CMF_AIMDIRECTION, owner.pitch);
            }
            lastBanner = "[7] PLASMA FAN";
            bannerTics = 28;
            break;

        case 8: // Flame Wave
            skillMaxCD[8] = 150;
            skillCD[8] = 150;
            owner.A_StartSound("weapons/firmfi", CHAN_AUTO, CHANF_OVERLAP, 1.0);
            for (int i = -3; i <= 3; i++)
            {
                owner.A_SpawnProjectile("SekiroFlameWave", 32, 0, i * 6.0, CMF_AIMDIRECTION, owner.pitch);
            }
            lastBanner = "[8] FLAME WAVE";
            bannerTics = 28;
            break;

        case 9: // BFG Execution
            skillMaxCD[9] = 350;
            skillCD[9] = 350;
            owner.A_StartSound("weapons/bfgf", CHAN_AUTO, CHANF_OVERLAP, 1.0);
            owner.A_SpawnProjectile("BFGBall", 36, 0, 0, CMF_AIMDIRECTION, owner.pitch);
            owner.A_SetBlend("44FF66", 0.2, 8);
            lastBanner = "[9] BFG EXECUTION";
            bannerTics = 35;
            break;
        }
    }
}

// ----------------------------------------------------------------------------
// 4. Primary Melee Weapon: SekiroBlade (Sword & Shield: LMB Slash, RMB Parry/Block, LMB/R Execute)
// ----------------------------------------------------------------------------
class SekiroBlade : Weapon
{
    int comboStep;

    Default
    {
        Tag "Sword & Shield";
        Weapon.SlotNumber 1;
        Weapon.SelectionOrder 1;
        +WEAPON.MELEEWEAPON;
        +WEAPON.NOALERT;
        +WEAPON.NOAUTOAIM;
        +INVENTORY.UNDROPPABLE;
        +INVENTORY.UNTOSSABLE;
        DamageType "SekiroSlash";
    }

    action Actor A_FindStunnedTarget(double maxDist = 128.0)
    {
        Actor best = null;
        double bestDist = maxDist;
        BlockThingsIterator it = BlockThingsIterator.Create(self, maxDist);
        while (it.Next())
        {
            Actor m = it.thing;
            if (!m || !m.bISMONSTER || m.health <= 0) continue;
            if (!m.FindInventory("SekiroStunToken")) continue;
            double d = Distance3D(m);
            if (d > bestDist) continue;
            double diff = abs(Actor.DeltaAngle(angle, AngleTo(m)));
            if (diff > 55.0) continue;
            if (!CheckSight(m)) continue;
            best = m;
            bestDist = d;
        }
        return best;
    }

    action void A_BeginDeathblow(Actor target)
    {
        let tok = SekiroParryToken(FindInventory("SekiroParryToken"));
        if (tok)
        {
            tok.execTarget = target;
            tok.parryGraceTics = 34; // Invulnerable during PB execution animation
            tok.guardTics = 0;
        }
        if (target)
        {
            // Face & lunge into stunned enemy
            A_SetAngle(AngleTo(target));
            double d = Distance2D(target);
            if (d > 56.0)
            {
                vel.x += cos(angle) * 14.0;
                vel.y += sin(angle) * 14.0;
            }
            let st = SekiroStunToken(target.FindInventory("SekiroStunToken"));
            if (st) st.RefreshStun(40);
        }
        A_ZoomFactor(1.12);
    }

    action void A_FinishDeathblow()
    {
        A_ZoomFactor(1.0);
        A_SetRoll(0, SPF_INTERPOLATE);
        let tok = SekiroParryToken(FindInventory("SekiroParryToken"));
        if (!tok) return;

        Actor target = tok.execTarget;
        tok.execTarget = null;
        if (target && target.health > 0)
        {
            // Massive execution damage: kills regular/medium demons outright, big chunk on bosses
            int dmg = (target.SpawnHealth() > 1000) ? 350 : max(250, target.health + 100);
            target.TakeInventory("SekiroStunToken", 1);
            target.DamageMobj(self, self, dmg, 'Extreme');
            for (int i = 0; i < 8; i++)
            {
                Vector3 sp = target.pos + (frandom(-14, 14), frandom(-14, 14), target.height * 0.55 + frandom(-8, 8));
                Actor.Spawn("SekiroParrySpark", sp);
            }
            tok.GrantDeathblowHeal();
        }
    }

    action void A_SekiroSlash(int dmg, double range, double angleSpread)
    {
        A_StartSound("AXSWING", CHAN_WEAPON, CHANF_OVERLAP, 0.9);
        for (int i = -1; i <= 1; i++)
        {
            FTranslatedLineTarget t;
            double ang = angle + i * angleSpread;
            int rayDmg = (i == 0) ? dmg : int(dmg * 0.55);
            LineAttack(ang, range, pitch, rayDmg, 'SekiroSlash', "SekiroBladePuff", LAF_ISMELEEATTACK, t);
            if (t.linetarget && i == 0)
            {
                A_StartSound("AXEHIT", CHAN_AUTO, CHANF_OVERLAP, 1.0);
                if (t.linetarget.bISMONSTER)
                {
                    t.linetarget.vel.x += cos(angle) * 4.0;
                    t.linetarget.vel.y += sin(angle) * 4.0;
                }
            }
        }
    }

    action void A_StartParryWindow()
    {
        let tok = SekiroParryToken(FindInventory("SekiroParryToken"));
        if (tok)
        {
            int baseWin = CVar.GetCVar("sk_parry_tics").GetInt();
            if (baseWin <= 0) baseWin = 7;

            // Anti-spam decay: rapidly tapping RMB shrinks the timed parry window
            if ((level.time - tok.lastParryTic) <= 18)
                tok.parrySpamCount = min(tok.parrySpamCount + 1, 3);
            else
                tok.parrySpamCount = 0;

            tok.lastParryTic = level.time;
            int effWin = max(2, baseWin - tok.parrySpamCount * 2);
            tok.parryTics = effWin;
            tok.guardTics = 4; // Shield is already raised even if parry window expires
        }
        A_StartSound("AXEDRAW", CHAN_WEAPON, CHANF_OVERLAP, 0.75, ATTN_NORM, 1.25);
    }

    action void A_MaintainGuard()
    {
        let tok = SekiroParryToken(FindInventory("SekiroParryToken"));
        if (tok)
        {
            tok.guardTics = 4;
        }
    }

    action void A_EndGuard()
    {
        let tok = SekiroParryToken(FindInventory("SekiroParryToken"));
        if (tok)
        {
            tok.guardTics = 0;
        }
    }

    States
    {
    Select:
        SWSH A 1 A_Raise(18);
        Loop;

    Deselect:
        SWSH A 1 A_Lower(18);
        Loop;

    Ready:
        SWSH A 1
        {
            A_EndGuard();
            A_WeaponReady(WRF_ALLOWRELOAD | WRF_ALLOWZOOM);
        }
        Loop;

    Reload:
        // Dedicated Execution key (R) when facing a stunned enemy
        TNT1 A 0
        {
            Actor st = A_FindStunnedTarget(128.0);
            if (st)
            {
                A_BeginDeathblow(st);
                return ResolveState("Deathblow");
            }
            return ResolveState("Ready");
        }

    Fire:
        TNT1 A 0
        {
            // Close-range LMB on a stunned enemy triggers PB Deathblow execution!
            Actor st = A_FindStunnedTarget(112.0);
            if (st)
            {
                A_BeginDeathblow(st);
                return ResolveState("Deathblow");
            }
            invoker.comboStep = (invoker.comboStep + 1) % 2;
            if (invoker.comboStep == 1)
                return ResolveState("Slash2");
            return ResolveState(null);
        }
    Slash1:
        SWSH A 1 Offset(14, 36);
        SWSH B 1 Offset(-8, 30) A_SekiroSlash(42, 108.0, 11.0);
        SWSH B 2 Offset(-18, 36);
        SWSH C 2 Offset(-10, 40);
        SWSH A 2 Offset(4, 34) A_WeaponReady(WRF_NOFIRE); // Parry-cancelable recovery
        Goto Ready;

    Slash2:
        SWSH A 1 Offset(-12, 36);
        SWSH C 1 Offset(8, 30) A_SekiroSlash(48, 112.0, 12.0);
        SWSH C 2 Offset(18, 36);
        SWSH B 2 Offset(10, 40);
        SWSH A 2 Offset(-4, 34) A_WeaponReady(WRF_NOFIRE); // Parry-cancelable recovery
        Goto Ready;

    AltFire:
        SWSH D 1 Offset(-6, 36) A_StartParryWindow();
        SWSH E 2 Offset(0, 32);
        SWSH D 4 Offset(0, 32);
    AltHold:
        SWSH D 2 Offset(0, 32)
        {
            A_MaintainGuard();
            let tok = SekiroParryToken(FindInventory("SekiroParryToken"));
            if (tok && tok.parryFlashTics > 6)
                return ResolveState("AltParryFlash");
            return ResolveState(null);
        }
        TNT1 A 0 A_ReFire("AltHold");
        SWSH D 1 Offset(-6, 38) A_EndGuard();
        SWSH A 2 Offset(0, 34);
        Goto Ready;

    AltParryFlash:
        SWSH E 3 Bright Offset(4, 28) A_MaintainGuard();
        Goto AltHold;

    Deathblow:
        // Uses Project Brutality's visceral first-person execution sprites (P1NK / P2NK / P2NO)
        P1NK ABCDE 1
        {
            A_SetPitch(pitch - 1.2);
            A_SetRoll(roll - 3.5);
        }
        TNT1 A 0
        {
            A_StartSound("weapons/ultrwhoosh", CHAN_AUTO);
            A_ZoomFactor(1.2);
        }
        P1NK FG 1
        {
            A_SetPitch(pitch + 5.0);
            A_SetRoll(roll + 7.0);
        }
        TNT1 A 0
        {
            A_StartSound("execution/impact", CHAN_AUTO);
            A_ZoomFactor(1.28);
        }
        P2NK HIJKLM 1
        {
            A_SetRoll(roll + 5.0);
            A_SetPitch(pitch + 1.5);
        }
        P2NK PQRS 1
        {
            A_SetRoll(roll - 10.0);
            A_SetPitch(pitch - 3.0);
        }
        TNT1 A 0
        {
            A_StartSound("gore/heavyimpact", CHAN_AUTO);
            A_FinishDeathblow();
        }
        P2NO EFGH 1
        {
            A_SetRoll(0, SPF_INTERPOLATE);
        }
        SWSH A 2 Offset(0, 34);
        Goto Ready;
    }
}

// ----------------------------------------------------------------------------
// 5. Core EventHandler: Projectile Slow/Deflect, Telegraphing, Skills & HUD
// ----------------------------------------------------------------------------
class SekiroEventHandler : EventHandler
{
    Array<Actor> telegraphedMonsters;
    Array<Actor> activeProjectiles;
    Array<Actor> pendingSlowProjectiles;

    // Automated self-test state (`netevent sk_selftest`)
    int selfTestStage;
    Actor stMon;
    Actor stProj;
    int stPassed;
    int stTotal;

    void AssertTest(string name, bool cond, string detail = "")
    {
        stTotal++;
        if (cond)
        {
            stPassed++;
            Console.Printf("[SEKIRO_TEST] PASS: %s %s", name, detail);
        }
        else
        {
            Console.Printf("[SEKIRO_TEST] FAIL: %s %s", name, detail);
        }
    }

    void StepSelfTest()
    {
        if (selfTestStage <= 0)
            return;

        PlayerInfo p = players[0];
        if (!p || !p.mo)
            return;
        let tok = SekiroParryToken(p.mo.FindInventory("SekiroParryToken"));
        if (!tok)
            return;

        if (selfTestStage == 1)
        {
            // T1: Loadout, Weapon Lock & PB Helmet Intro Suppressed
            bool hasBlade = (p.ReadyWeapon is "SekiroBlade");
            p.mo.GiveInventory("Shotgun", 1);
            EnsurePlayerLoadout(p);
            bool locked = (p.ReadyWeapon is "SekiroBlade") || (p.PendingWeapon is "SekiroBlade");
            class<Inventory> introCls = "IntroductionSequence";
            bool noHelmet = (!introCls) || (p.mo.FindInventory(introCls) != null);
            Name readyName = p.ReadyWeapon ? p.ReadyWeapon.GetClassName() : 'none';
            AssertTest("T1_LoadoutLockAndNoHelmet", hasBlade && locked && noHelmet,
                String.Format("(ready=%s noHelmet=%d)", readyName, noHelmet));

            // T2: Spawn monster + fast enemy projectile -> verify slowdown, visibility & gravity scaling
            Vector3 mpos = p.mo.pos + (cos(p.mo.angle) * 160.0, sin(p.mo.angle) * 160.0, 0);
            stMon = Actor.Spawn("DoomImp", mpos);
            if (stMon)
            {
                stMon.health = 500;
                stMon.bNOPAIN = false;
                stMon.angle = stMon.AngleTo(p.mo);
                Name pbTracer = 'MonsterNewMinigunTracer';
                class<Actor> projCls = pbTracer;
                if (!projCls) projCls = "DoomImpBall";
                stProj = stMon.SpawnMissile(p.mo, projCls);
                if (stProj)
                {
                    stProj.bNOGRAVITY = false;
                    stProj.Gravity = 1.0;
                    Vector3 clearPos = p.mo.pos + (cos(p.mo.angle) * 72.0, sin(p.mo.angle) * 72.0, 32.0);
                    stProj.SetOrigin(clearPos, false);
                }
            }

            selfTestStage = 2;
            return;
        }

        if (selfTestStage == 2)
        {
            double spd = stProj ? stProj.vel.Length() : -1.0;
            bool bright = stProj ? stProj.bBRIGHT : false;
            double sc = stProj ? stProj.Scale.x : 0.0;
            double grav = stProj ? stProj.Gravity : 1.0;
            AssertTest("T2_ProjectileSlowAndGravityScale", stProj != null && spd > 0.1 && spd <= 14.5 && bright && sc >= 0.5 && grav < 0.2,
                String.Format("(spd=%.2f bright=%d scale=%.2f grav=%.3f)", spd, bright, sc, grav));

            if (stProj)
            {
                Vector3 front = p.mo.pos + (cos(p.mo.angle) * 56.0, sin(p.mo.angle) * 56.0, 32.0);
                stProj.SetOrigin(front, false);
            }
            tok.parryTics = 7;
            tok.parryGraceTics = 0;
            tok.parryStreak = 0;
            selfTestStage = 3;
            return;
        }

        if (selfTestStage == 3)
        {
            // T3: Projectile Parry deflects/ricochets & does NOT stun shooter
            bool handled = (stProj != null && stProj.target == p.mo && stProj.vel.Length() >= 20.0);
            let stun = stMon ? SekiroStunToken(stMon.FindInventory("SekiroStunToken")) : null;
            AssertTest("T3_ProjectileParryNoStun", handled && tok.parryStreak >= 1 && stun == null,
                String.Format("(handled=%d spd=%.1f streak=%d stunned=%d)",
                    handled, stProj ? stProj.vel.Length() : 0.0, tok.parryStreak, stun != null));

            if (stProj) stProj.Destroy();

            // T4: Melee Parry -> 0 damage + stun (DoomImp SpawnHealth=60 -> 1 parry)
            if (stMon)
            {
                stMon.TakeInventory("SekiroStunToken", 1);
                stMon.TakeInventory("SekiroPostureToken", 1);
                Vector3 closePos = p.mo.pos + (cos(p.mo.angle) * 64.0, sin(p.mo.angle) * 64.0, 0);
                stMon.SetOrigin(closePos, false);
            }
            int hpBefore = p.mo.health;
            tok.parryTics = 7;
            tok.parryGraceTics = 0;
            p.mo.DamageMobj(stMon, stMon, 25, 'Melee');
            stun = stMon ? SekiroStunToken(stMon.FindInventory("SekiroStunToken")) : null;
            AssertTest("T4_MeleeParryAndStun", p.mo.health == hpBefore && stun != null && stun.stunTics > 0,
                String.Format("(hp=%d/%d stun=%d)", p.mo.health, hpBefore, stun ? stun.stunTics : 0));

            // T5: 3x Riposte + Deathblow +20 HP Heal on kill
            p.mo.health = 70;
            p.health = 70;
            if (stMon) stMon.health = 80;
            if (stMon) stMon.DamageMobj(p.mo, p.mo, 40, 'SekiroSlash');
            AssertTest("T5_RiposteAndDeathblowHeal", stMon != null && stMon.health <= 0 && p.mo.health == 90 && p.health == 90,
                String.Format("(monHp=%d playerHp=%d/%d expected=90)", stMon ? stMon.health : -999, p.mo.health, p.health));

            // T6: Multi-pellet shotgun parry grace window (6 hits = 0 dmg)
            if (stMon) stMon.Destroy();
            Vector3 mpos2 = p.mo.pos + (cos(p.mo.angle) * 90.0, sin(p.mo.angle) * 90.0, 0);
            stMon = Actor.Spawn("DoomImp", mpos2);
            int hpGrace = p.mo.health;
            tok.parryTics = 0;
            tok.parryGraceTics = 6;
            for (int k = 0; k < 6; k++)
                p.mo.DamageMobj(stMon, stMon, 10, 'Shotgun');
            AssertTest("T6_MultiPelletGrace", p.mo.health == hpGrace,
                String.Format("(hp=%d/%d)", p.mo.health, hpGrace));

            // T7: Held Shield Block takes reduced chip damage (~35%) & does NOT stun
            if (stMon) stMon.TakeInventory("SekiroStunToken", 1);
            int hpGuard = p.mo.health;
            tok.parryTics = 0;
            tok.parryGraceTics = 0;
            tok.guardTics = 4;
            p.mo.DamageMobj(stMon, stMon, 25, 'Melee');
            int guardTaken = hpGuard - p.mo.health;
            stun = stMon ? SekiroStunToken(stMon.FindInventory("SekiroStunToken")) : null;
            AssertTest("T7_ShieldBlockChipDamage", guardTaken == 8 && stun == null,
                String.Format("(taken=%d expected=8 stunned=%d)", guardTaken, stun != null));

            // T8: All 9 Instant Skills + Parry Cooldown Shave
            bool allCD = true;
            for (int s = 1; s <= 9; s++)
            {
                tok.skillCD[s] = 0;
                tok.CastSkill(s);
                if (tok.skillCD[s] <= 0) allCD = false;
            }
            int cd9Before = tok.skillCD[9];
            tok.TriggerParrySuccess(null, null, false);
            int cd9After = tok.skillCD[9];
            bool stillBlade = (p.ReadyWeapon is "SekiroBlade");
            AssertTest("T8_All9SkillsAndParryCDShave", allCD && stillBlade && (cd9Before - cd9After) == 15,
                String.Format("(allCD=%d blade=%d cd9=%d->%d)", allCD, stillBlade, cd9Before, cd9After));

            if (stMon) stMon.Destroy();
            Console.Printf("[SEKIRO_TEST] SUMMARY: %d/%d PASSED", stPassed, stTotal);
            selfTestStage = 0;
        }
    }

    bool IsModEnabled() const
    {
        CVar c = CVar.GetCVar("sk_enabled");
        return !c || c.GetBool();
    }

    void EnsurePlayerLoadout(PlayerInfo p)
    {
        if (!p || !p.mo || p.mo.health <= 0)
            return;

        // Suppress Project Brutality's delayed helmet-put-on intro animation
        class<Inventory> introCls = "IntroductionSequence";
        if (introCls && !p.mo.FindInventory(introCls))
            p.mo.GiveInventory(introCls, 1);

        if (!p.mo.FindInventory("SekiroParryToken"))
            p.mo.GiveInventory("SekiroParryToken", 1);

        if (!p.mo.FindInventory("SekiroBlade"))
            p.mo.GiveInventory("SekiroBlade", 1);

        if (p.ReadyWeapon == null || !(p.ReadyWeapon is "SekiroBlade"))
        {
            let blade = Weapon(p.mo.FindInventory("SekiroBlade"));
            if (blade)
                p.PendingWeapon = blade;
        }
    }

    override void PlayerEntered(PlayerEvent e)
    {
        if (!IsModEnabled()) return;
        EnsurePlayerLoadout(players[e.PlayerNumber]);
    }

    override void PlayerRespawned(PlayerEvent e)
    {
        if (!IsModEnabled()) return;
        EnsurePlayerLoadout(players[e.PlayerNumber]);
    }

    void SlowEnemyProjectile(Actor a)
    {
        if (!a || !a.bMISSILE || !a.target || !a.target.bISMONSTER)
            return;

        double maxSpd = CVar.GetCVar("sk_proj_maxspeed").GetFloat();
        double scale = CVar.GetCVar("sk_proj_scale").GetFloat();
        if (maxSpd <= 1.0) maxSpd = 14.0;
        if (scale <= 0.05) scale = 0.45;

        double spd = a.vel.Length();
        if (spd > 0.1)
        {
            double newSpd = clamp(spd * scale, 7.5, maxSpd);
            double ratio = newSpd / spd;
            a.vel = a.vel.Unit() * newSpd;
            a.Speed = newSpd;
            // Scale gravity by ratio^2 so bullets don't drop into the floor while grenades keep their arc!
            if (!a.bNOGRAVITY)
            {
                a.Gravity = a.Gravity * ratio * ratio;
            }
        }

        a.bBRIGHT = true;
        if (a.Scale.x > 0 && a.Scale.x < 0.45)
        {
            a.Scale.x = 0.55;
            a.Scale.y = 0.55;
        }
    }

    void ProcessPendingProjectiles()
    {
        for (int k = pendingSlowProjectiles.Size() - 1; k >= 0; k--)
        {
            Actor a = pendingSlowProjectiles[k];
            pendingSlowProjectiles.Delete(k);
            if (a && a.bMISSILE && a.target && a.target.bISMONSTER)
            {
                SlowEnemyProjectile(a);
                if (activeProjectiles.Find(a) == activeProjectiles.Size())
                    activeProjectiles.Push(a);
            }
        }
    }

    override void WorldThingSpawned(WorldEvent e)
    {
        if (!IsModEnabled() || !e.Thing)
            return;

        Actor a = e.Thing;
        if (!a.bMISSILE)
            return;

        if (a.target && a.target.bISMONSTER && a.vel.Length() > 0.1)
        {
            SlowEnemyProjectile(a);
            if (activeProjectiles.Find(a) == activeProjectiles.Size())
                activeProjectiles.Push(a);
        }
        else
        {
            pendingSlowProjectiles.Push(a);
        }
    }

    override void WorldTick()
    {
        if (!IsModEnabled())
            return;

        ProcessPendingProjectiles();

        for (int k = activeProjectiles.Size() - 1; k >= 0; k--)
        {
            Actor m = activeProjectiles[k];
            if (!m || !m.bMISSILE)
                activeProjectiles.Delete(k);
        }

        double reflectChance = CVar.GetCVar("sk_reflect_chance").GetFloat();
        if (reflectChance < 0.0 || reflectChance > 1.0) reflectChance = 0.45;

        for (int i = 0; i < MAXPLAYERS; i++)
        {
            if (!playeringame[i]) continue;
            PlayerInfo p = players[i];
            if (!p || !p.mo || p.mo.health <= 0) continue;

            EnsurePlayerLoadout(p);

            let tok = SekiroParryToken(p.mo.FindInventory("SekiroParryToken"));
            if (!tok) continue;

            // Active projectile parry during timed parry window
            if (tok.parryTics > 0 || tok.parryGraceTics > 0)
            {
                for (int k = activeProjectiles.Size() - 1; k >= 0; k--)
                {
                    Actor m = activeProjectiles[k];
                    if (!m || !m.bMISSILE || !m.target || m.target == p.mo)
                        continue;
                    if (!m.target.bISMONSTER)
                        continue;

                    double dist = p.mo.Distance3D(m);
                    if (dist > 96.0)
                        continue;

                    if (tok.parryGraceTics <= 0 && !tok.IsInFront(m))
                        continue;

                    Actor origShooter = m.target;
                    bool doReflect = (frandom(0.0, 1.0) < reflectChance);
                    Vector3 aimDir;
                    string banner;

                    if (doReflect && origShooter && origShooter.health > 0)
                    {
                        Vector3 aimTarget = origShooter.pos + (0, 0, origShooter.height * 0.55);
                        aimDir = (aimTarget - m.pos).Unit();
                        double reflectSpd = max(28.0, m.vel.Length() * 2.2);
                        m.vel = aimDir * reflectSpd;
                        m.Speed = reflectSpd;
                        m.bNOGRAVITY = true;
                        m.target = p.mo;
                        m.angle = VectorAngle(aimDir.x, aimDir.y);
                        banner = "DEFLECTED!";
                    }
                    else
                    {
                        // Ricochet harmlessly away at a random sideways/upward angle
                        double sideAng = p.mo.angle + (random(0, 1) == 0 ? 1.0 : -1.0) * frandom(55.0, 120.0);
                        double upZ = frandom(0.25, 0.65);
                        aimDir = (cos(sideAng), sin(sideAng), upZ).Unit();
                        m.vel = aimDir * 24.0;
                        m.Speed = 24.0;
                        m.target = p.mo;
                        m.angle = sideAng;
                        banner = "PARRIED!";
                    }

                    // Blocked/reflected bullets do NOT stun the shooter (allowStun = false)
                    tok.TriggerParrySuccess(origShooter, m, false, banner);
                }
            }
        }

        // Enemy melee telegraphing (every 2 tics)
        if ((level.time % 2) == 0 && CVar.GetCVar("sk_telegraph").GetBool())
        {
            for (int k = telegraphedMonsters.Size() - 1; k >= 0; k--)
            {
                Actor mon = telegraphedMonsters[k];
                if (!mon || mon.health <= 0 || !mon.InStateSequence(mon.CurState, mon.MeleeState))
                    telegraphedMonsters.Delete(k);
            }

            for (int i = 0; i < MAXPLAYERS; i++)
            {
                if (!playeringame[i] || !players[i].mo || players[i].mo.health <= 0)
                    continue;

                BlockThingsIterator it = BlockThingsIterator.Create(players[i].mo, 220.0);
                while (it.Next())
                {
                    Actor mon = it.thing;
                    if (!mon || !mon.bISMONSTER || mon.health <= 0)
                        continue;
                    if (!mon.MeleeState)
                        continue;
                    if (mon.FindInventory("SekiroStunToken"))
                        continue;

                    if (mon.InStateSequence(mon.CurState, mon.MeleeState))
                    {
                        if (telegraphedMonsters.Find(mon) == telegraphedMonsters.Size())
                        {
                            telegraphedMonsters.Push(mon);
                            mon.tics += 5;
                            Vector3 fpos = mon.pos + (0, 0, mon.height * 0.78);
                            Actor.Spawn("SekiroTelegraphFlash", fpos);
                            mon.A_StartSound("AXEDRAW", CHAN_AUTO, CHANF_OVERLAP, 0.55, ATTN_NORM, 1.5);
                        }
                    }
                }
            }
        }

        StepSelfTest();
    }

    override bool InputProcess(InputEvent e)
    {
        if (!IsModEnabled())
            return false;
        if (gamestate != GS_LEVEL || menuactive != Menu.Off)
            return false;

        if (e.Type == InputEvent.Type_KeyDown && e.KeyChar >= 49 && e.KeyChar <= 57) // '1'..'9'
        {
            int slot = e.KeyChar - 48;
            EventHandler.SendNetworkEvent("sk_skill", slot);
            return true;
        }
        return false;
    }

    override void NetworkProcess(ConsoleEvent e)
    {
        if (!IsModEnabled())
            return;

        if (e.Name == "sk_skill" && e.Player >= 0 && e.Player < MAXPLAYERS)
        {
            PlayerInfo p = players[e.Player];
            if (p && p.mo && p.mo.health > 0)
            {
                let tok = SekiroParryToken(p.mo.FindInventory("SekiroParryToken"));
                if (tok)
                    tok.CastSkill(e.Args[0]);
            }
        }
        else if (e.Name == "sk_selftest")
        {
            stPassed = 0;
            stTotal = 0;
            selfTestStage = 1;
        }
    }

    override void RenderOverlay(RenderEvent e)
    {
        if (!IsModEnabled() || gamestate != GS_LEVEL)
            return;

        PlayerInfo p = players[consoleplayer];
        if (!p || !p.mo || p.mo.health <= 0)
            return;

        let tok = SekiroParryToken(p.mo.FindInventory("SekiroParryToken"));
        if (!tok)
            return;

        int sw = Screen.GetWidth();
        int sh = Screen.GetHeight();
        Font fnt = SmallFont;
        double scale = max(1.0, sh / 480.0);

        string statusTxt = "";
        int statusCol = Font.CR_WHITE;
        if (tok.parryFlashTics > 0)
        {
            statusTxt = tok.lastBanner.Length() > 0 ? tok.lastBanner : String.Format("PARRIED! (x%d)", tok.parryStreak);
            statusCol = Font.CR_GOLD;
        }
        else if (tok.parryTics > 0)
        {
            statusTxt = "[ PARRY ]";
            statusCol = Font.CR_YELLOW;
        }
        else if (tok.guardTics > 0)
        {
            statusTxt = "[ SHIELD BLOCK ]";
            statusCol = Font.CR_LIGHTBLUE;
        }

        if (statusTxt.Length() > 0)
        {
            int tw = int(fnt.StringWidth(statusTxt) * scale);
            Screen.DrawText(fnt, statusCol, (sw - tw) / 2, int(sh * 0.68), statusTxt, DTA_ScaleX, scale, DTA_ScaleY, scale);
        }

        if (tok.bannerTics > 0 && tok.lastBanner.Length() > 0 && tok.parryFlashTics <= 0)
        {
            int bw = int(fnt.StringWidth(tok.lastBanner) * scale);
            Screen.DrawText(fnt, Font.CR_CYAN, (sw - bw) / 2, int(sh * 0.72), tok.lastBanner, DTA_ScaleX, scale, DTA_ScaleY, scale);
        }

        static const string names[] = { "", "Axe", "Shot", "Buck", "Dash", "Mini", "Rkt", "Plsm", "Fire", "BFG" };
        int boxW = int(42 * scale);
        int totalW = boxW * 9;
        int startX = (sw - totalW) / 2;
        int y = int(8 * scale);

        for (int s = 1; s <= 9; s++)
        {
            int bx = startX + (s - 1) * boxW;
            bool ready = (tok.skillCD[s] <= 0);
            string label = ready ? String.Format("%d:%s", s, names[s]) : String.Format("%d:%.1f", s, tok.skillCD[s] / 35.0);
            int col = ready ? Font.CR_GREEN : Font.CR_DARKGRAY;
            Screen.DrawText(fnt, col, bx, y, label, DTA_ScaleX, scale * 0.75, DTA_ScaleY, scale * 0.75);
        }
    }
}
